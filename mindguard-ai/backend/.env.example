# Copy to backend/.env to override defaults (all optional).
SISYPHUS_DATABASE_URL=sqlite:///./sisyphus.db
SISYPHUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SISYPHUS_SEED=42
SISYPHUS_EMPLOYEES=100
SISYPHUS_HISTORY_DAYS=60
SISYPHUS_END_DATE=2026-10-30
SISYPHUS_CONTAMINATION=0.05
# Seed an empty database and (re)train a missing model when the API starts
SISYPHUS_AUTO_BOOTSTRAP=true
